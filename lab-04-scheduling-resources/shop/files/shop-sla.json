      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (code) (rate(shop_http_requests_total{namespace=\"shop\",path=\"/order\"}[30s]))",
          "legendFormat": "{{code}}",
          "refId": "A"
        }
      ],
      "title": "POST /order, запросов в секунду",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "spanNulls": false },
          "unit": "s",
          "min": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "граница SLA 300 мс" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "dash": [8, 8], "fill": "dash" } },
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
