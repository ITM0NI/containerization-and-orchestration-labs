          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "vector(0.3)",
          "legendFormat": "граница SLA 300 мс",
          "refId": "C"
        }
      ],
      "title": "Задержка POST /order",
      "type": "timeseries"
    },
