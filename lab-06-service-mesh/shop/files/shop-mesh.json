{
  "uid": "shop-mesh",
  "title": "Shop Service Mesh",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "15s",
  "time": {"from": "now-30m", "to": "now"},
  "tags": ["lab6", "linkerd"],
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Mesh: backend 5xx по версиям, %",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0}, "overrides": []},
      "targets": [{"refId": "A", "expr": "100 * (sum by(backend_name)(rate(outbound_http_route_backend_response_statuses_total{namespace=\"shop\",service=\"api-proxy-metrics\",parent_name=\"api\",http_status=~\"5..\"}[1m])) or (0 * sum by(backend_name)(rate(outbound_http_route_backend_response_statuses_total{namespace=\"shop\",service=\"api-proxy-metrics\",parent_name=\"api\"}[1m])))) / sum by(backend_name)(rate(outbound_http_route_backend_response_statuses_total{namespace=\"shop\",service=\"api-proxy-metrics\",parent_name=\"api\"}[1m]))", "legendFormat": "{{backend_name}}"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 2, "type": "timeseries", "title": "Mesh: backend p95 по версиям",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by(le,backend_name)(rate(outbound_http_route_backend_response_duration_seconds_bucket{namespace=\"shop\",service=\"api-proxy-metrics\",parent_name=\"api\"}[1m])))", "legendFormat": "{{backend_name}}"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 3, "type": "timeseries", "title": "Mesh: фактическая доля v2, % попыток",
      "description": "Backend requests, одна исходящая сторона. При повторах это доля попыток, не исходных запросов. В сценариях канарейки повторы выключены.",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "targets": [{"refId": "A", "expr": "100 * (sum(rate(outbound_http_route_backend_requests_total{namespace=\"shop\",service=\"api-proxy-metrics\",parent_name=\"api\",backend_name=\"api-v2\"}[1m])) or vector(0)) / sum(rate(outbound_http_route_backend_requests_total{namespace=\"shop\",service=\"api-proxy-metrics\",parent_name=\"api\"}[1m]))", "legendFormat": "v2, mesh"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 4, "type": "timeseries", "title": "Mesh: ошибки backend и клиента, %",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "100 * (sum(rate(outbound_http_route_backend_response_statuses_total{namespace=\"shop\",service=\"api-proxy-metrics\",parent_name=\"api\",http_status=~\"5..\"}[1m])) or vector(0)) / sum(rate(outbound_http_route_backend_response_statuses_total{namespace=\"shop\",service=\"api-proxy-metrics\",parent_name=\"api\"}[1m]))", "legendFormat": "backend, до retries"},
        {"refId": "B", "expr": "100 * (sum(rate(outbound_http_route_request_statuses_total{namespace=\"shop\",service=\"api-proxy-metrics\",parent_name=\"api\",http_status=~\"5..\"}[1m])) or vector(0)) / sum(rate(outbound_http_route_request_statuses_total{namespace=\"shop\",service=\"api-proxy-metrics\",parent_name=\"api\"}[1m]))", "legendFormat": "клиент, после retries"}
      ],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 5, "type": "timeseries", "title": "Mesh: повторы в секунду",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum(rate(outbound_http_route_retry_requests_total{namespace=\"shop\",service=\"api-proxy-metrics\",parent_name=\"api\"}[1m])) or vector(0)", "legendFormat": "retries, Linkerd"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 6, "type": "timeseries", "title": "cAdvisor: CPU приложения и прокси",
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "cores", "min": 0}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by(container)(rate(container_cpu_usage_seconds_total{namespace=\"shop\",container=~\"api|linkerd-proxy\",image!=\"\"}[1m]))", "legendFormat": "{{container}}, сумма реплик"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 7, "type": "timeseries", "title": "cAdvisor: память приложения и прокси",
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by(container)(container_memory_working_set_bytes{namespace=\"shop\",container=~\"api|linkerd-proxy\",image!=\"\"})", "legendFormat": "{{container}}, сумма реплик"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 8, "type": "timeseries", "title": "App: /order, ошибки и p95 v2",
      "description": "Эти прикладные метрики использует гейт. Mesh-панели выше учитывают HTTPRoute целиком, без метки path.",
      "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": [{"matcher": {"id": "byName", "options": "5xx, доля"}, "properties": [{"id": "unit", "value": "percentunit"}, {"id": "custom.axisPlacement", "value": "right"}]}]},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95, sum by(le)(rate(shop_http_request_duration_seconds_bucket{namespace=\"shop\",service=\"api-v2\",version=\"v2\",path=\"/order\"}[1m])))", "legendFormat": "p95, секунды"},
        {"refId": "B", "expr": "(sum(rate(shop_http_requests_total{namespace=\"shop\",service=\"api-v2\",version=\"v2\",path=\"/order\",code=~\"5..\"}[1m])) or vector(0)) / sum(rate(shop_http_requests_total{namespace=\"shop\",service=\"api-v2\",version=\"v2\",path=\"/order\"}[1m]))", "legendFormat": "5xx, доля"}
      ],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    }
  ]
}
